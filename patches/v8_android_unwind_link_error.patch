diff --git a/build/config/android/BUILD.gn b/build/config/android/BUILD.gn
index 8c77eb2c9..a0d5462cc 100644
--- a/build/config/android/BUILD.gn
+++ b/build/config/android/BUILD.gn
@@ -71,6 +71,28 @@ config("compiler") {
     cflags += [ "-mtls-dialect=trad" ]
   }
 
+  ldflags += [ "--unwindlib=libunwind" ]
+  if (!defined(libs)) {
+    libs = []
+  }
+  libs += [ "unwind" ]
+
+  if (current_cpu == "x86") {
+    arch_dir = "i386"
+  } else if (current_cpu == "x64") {
+    arch_dir = "x86_64"
+  } else if (current_cpu == "arm") {
+    arch_dir = "arm"
+  } else if (current_cpu == "arm64") {
+    arch_dir = "aarch64"
+  } else {
+    assert(false, "Unknown Android ABI: " + current_cpu)
+  }
+  if (!defined(lib_dirs)) {
+    lib_dirs = []
+  }
+  lib_dirs += [ "$android_toolchain_root/lib/clang/18/lib/linux/$arch_dir" ]
+
   # $compile_api_level corresponds to the API level used for the sysroot path
   # calculation in //build/config/android/config.gni
   if (android_64bit_target_cpu) {
